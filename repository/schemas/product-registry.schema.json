{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zui-webos.example/schemas/product-registry.schema.json",
  "title": "ZUI webOS Product Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "products"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "repository",
          "appIds",
          "deploymentModel",
          "releaseSource",
          "rootlessCompatible",
          "sourceModel"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "repository": {
            "type": "string",
            "pattern": "^https://github\\.com/ZUI-WebOS/[A-Za-z0-9._-]+$"
          },
          "appIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "deploymentModel": { "const": "developer-mode-ipk" },
          "releaseSource": { "const": "github-releases" },
          "rootlessCompatible": { "const": true },
          "sourceModel": { "const": "external-product-repository" }
        }
      }
    }
  }
}
