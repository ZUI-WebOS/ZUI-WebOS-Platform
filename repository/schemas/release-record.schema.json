{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZUI-WebOS/ZUI-WebOS-Platform/repository/schemas/release-record.schema.json",
  "title": "ZUI webOS release record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "productId", "version", "channel", "sourceRepository", "artifacts"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "productId": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["stable", "staging"] },
    "sourceRepository": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+$" },
    "releaseRef": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactId", "filename", "appId", "version", "deploymentClass", "size", "hash", "source"],
        "properties": {
          "artifactId": { "type": "string", "minLength": 1 },
          "filename": { "type": "string", "pattern": "\\.ipk$" },
          "appId": { "type": "string", "pattern": "^[A-Za-z0-9]+([._-][A-Za-z0-9]+)+$" },
          "version": { "type": "string", "minLength": 1 },
          "deploymentClass": { "enum": ["production", "staging"] },
          "size": { "type": "integer", "minimum": 0 },
          "hash": {
            "type": "object",
            "additionalProperties": false,
            "required": ["algorithm", "digest"],
            "properties": {
              "algorithm": { "const": "sha256" },
              "digest": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "repository"],
            "properties": {
              "type": { "enum": ["LOCAL_VERIFIED", "GITHUB_RELEASE", "EXTERNAL"] },
              "repository": { "type": "string" },
              "releaseRef": { "type": "string" },
              "assetName": { "type": "string" },
              "canonicalAssetUrl": { "type": "string" },
              "evidencePath": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
