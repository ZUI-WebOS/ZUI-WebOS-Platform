{
  "name": "@zui-webos/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Rootless management platform and developer tooling for ZUI applications on LG webOS TVs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm build && vitest run",
    "lint": "pnpm build && eslint apps packages tests",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,css,html,json}\" \"packages/**/*.{ts,tsx,css,json}\" \"tests/**/*.{ts,tsx}\" \"*.{ts,json,yaml,yml}\" \".github/**/*.{yaml,yml}\"",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "web": "pnpm --filter @zui-webos/web-portal build && pnpm --filter @zui-webos/web-portal start",
    "web:mock": "pnpm --filter @zui-webos/web-portal build && cross-env ZUI_WEB_MANAGER_MOCK=1 pnpm --filter @zui-webos/web-portal start",
    "tv-store:dev": "cross-env ZUI_TV_STORE_MODE=DEMO pnpm --filter @zui-webos/tv-store dev",
    "tv-store:api:mock": "pnpm --filter @zui-webos/tv-store build && cross-env ZUI_TV_STORE_MOCK=1 pnpm --filter @zui-webos/tv-store start:api",
    "tv-store:api:live": "cross-env ZUI_TV_STORE_MODE=LIVE pnpm --filter @zui-webos/tv-store build && cross-env ZUI_TV_STORE_MODE=LIVE pnpm --filter @zui-webos/tv-store start:api",
    "tv-store:install-service": "pnpm --filter @zui-webos/tv-store build && node apps/tv-store/dist/install-server.js",
    "tv-store:package": "cross-env ZUI_TV_STORE_MODE=DEMO pnpm --filter @zui-webos/tv-store package:webos",
    "tv-store:package:live": "cross-env ZUI_TV_STORE_MODE=LIVE pnpm --filter @zui-webos/tv-store package:webos"
  },
  "devDependencies": {
    "@zui-webos/catalog-contracts": "workspace:*",
    "@zui-webos/catalog-service": "workspace:*",
    "@zui-webos/devmode-keeper": "workspace:*",
    "@zui-webos/installation-planner": "workspace:*",
    "@zui-webos/installer-service": "workspace:*",
    "@zui-webos/artifact-distribution": "workspace:*",
    "@zui-webos/signed-release": "workspace:*",
    "@zui-webos/package-inspector": "workspace:*",
    "@zui-webos/release-operations": "workspace:*",
    "@zui-webos/runtime-paths": "workspace:*",
    "@zui-webos/shared-types": "workspace:*",
    "@zui-webos/webos-client": "workspace:*",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "cross-env": "^10.1.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "5.0.3"
  }
}
