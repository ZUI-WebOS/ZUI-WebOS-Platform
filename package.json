{
  "name": "@zui-webos/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Rootless management platform and developer tooling for ZUI applications on LG webOS TVs.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm build && vitest run",
    "lint": "pnpm build && eslint apps packages tests",
    "format:check": "prettier --check \"apps/**/*.ts\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"*.{json,yaml,yml}\" \".github/**/*.{yaml,yml}\"",
    "verify": "pnpm format:check && pnpm lint && pnpm type-check && pnpm test && pnpm build",
    "zui-webos": "pnpm --filter @zui-webos/devmode-keeper start"
  },
  "devDependencies": {
    "@zui-webos/catalog-contracts": "workspace:*",
    "@zui-webos/shared-types": "workspace:*",
    "@zui-webos/webos-client": "workspace:*",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "4.1.11"
  }
}
