{
  "name": "@zui-webos/tv-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/stage-webos-package.mjs",
    "type-check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "start:api": "node dist/server.js",
    "dev": "vite",
    "package:webos": "pnpm build && ares-package -n dist/webos -o dist/ipk"
  },
  "dependencies": {
    "@zui-webos/catalog-contracts": "workspace:*",
    "@zui-webos/catalog-service": "workspace:*",
    "@zui-webos/design-system": "workspace:*",
    "@zui-webos/shared-types": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "catalog:",
    "vite": "^7.1.7"
  }
}
